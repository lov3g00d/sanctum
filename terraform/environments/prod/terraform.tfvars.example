account_id = "210987654321"
region     = "eu-central-1"

# Prod keeps the EKS public endpoint reachable only from a tight allowlist
# (bastion / VPN egress). Never 0.0.0.0/0.
eks_public_access_cidrs = ["198.51.100.10/32"]
eks_admin_arns          = ["arn:aws:iam::210987654321:role/platform-admin"]

cloudflare_zone_id         = "0123456789abcdef0123456789abcdef"
cloudflare_origin_hostname = "orders-api.eu-central-1.elb.amazonaws.com"

# Prod CI runs behind a GitHub Environment protection rule.
github_subject_claims = ["repo:nimbus-org/nimbus:environment:production"]

# Secret: do not put this in a committed tfvars. Prefer:
#   export TF_VAR_cloudflare_api_token=...
# cloudflare_api_token = "..."
