---
extends: default

rules:
  # Falco output strings and Kyverno subjectRegExp/imageReferences run long;
  # 200 keeps them on one line without inviting sloppy wrapping elsewhere.
  line-length:
    max: 200
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: 2
    indent-sequences: true
