---
# Attack manifests carry long MITRE and annotation strings plus full image
# references, so line-length is relaxed to a warning here. The rest of the
# default ruleset still applies. Mirrors cicd/.yamllint's shape for consistency.
extends: default

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start:
    present: true
